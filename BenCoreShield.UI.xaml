<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenCore Shield | Security Inspector" Width="1220" Height="790"
        MinWidth="990" MinHeight="630" WindowStartupLocation="CenterScreen"
        Background="#0B1322" Foreground="#E9F2FC" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#132238" />
    <SolidColorBrush x:Key="DividerBrush" Color="#294058" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A7BED6" />
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Foreground" Value="#0A1D2C"/><Setter Property="Background" Value="#65D4F6"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button" x:Key="QuietButton" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="#E5F1FC"/><Setter Property="Background" Value="#233850"/>
      <Setter Property="BorderBrush" Value="#365574"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Foreground" Value="#B8CAE0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,12"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Border" x:Key="CardBorder">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="19"/><Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#132238"/><Setter Property="Foreground" Value="#EAF4FD"/>
      <Setter Property="RowBackground" Value="#132238"/><Setter Property="AlternatingRowBackground" Value="#1A2C44"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="33"/>
      <Setter Property="ColumnHeaderHeight" Value="35"/><Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#20334B"/><Setter Property="Foreground" Value="#D8ECFE"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#236187"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="HintText"><Setter Property="Foreground" Value="#A7BED6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="TextBlock" x:Key="SectionTitle"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#101E32" BorderBrush="#273C54" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,23,18,16">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,0,0,3">
            <Border Width="43" Height="43" CornerRadius="11" Background="#1D607A" Margin="0,0,10,0">
              <TextBlock Text="B" FontWeight="Bold" Foreground="#8CE6FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="BenCore" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="SHIELD / v1.0" FontSize="10" Foreground="#87CADF"/></StackPanel>
          </StackPanel>
          <TextBlock Text="SECURITY WORKSPACE" Foreground="#7F98B4" FontSize="10" FontWeight="SemiBold" Margin="8,27,0,8"/>
          <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="⌂  Overview"/>
          <Button x:Name="NavProcesses" Style="{StaticResource NavButton}" Content="▦  Running processes"/>
          <Button x:Name="NavServices" Style="{StaticResource NavButton}" Content="⚙  Windows services"/>
          <Button x:Name="NavStartup" Style="{StaticResource NavButton}" Content="↗  Startup &amp; tasks"/>
          <Button x:Name="NavDetections" Style="{StaticResource NavButton}" Content="◉  Defender history"/>
          <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Content="ⓘ  About &amp; safety"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Background="#182D44" CornerRadius="9" Padding="12">
            <StackPanel><TextBlock Text="READ-ONLY BY DEFAULT" Foreground="#72D9F1" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="No automatic process killing, file deletion or service disabling." Foreground="#B4C8DC" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
          </Border>
          <TextBlock Text="Developed by Benie Mansueto Vison" Foreground="#83A1BA" TextWrapping="Wrap" Margin="6,17,0,0" FontSize="10"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="25,17,20,13">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
        <StackPanel><TextBlock Text="Protect the Core. Secure the System." Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="TxtComputer" Text="Local Windows security inspection" Foreground="#A5BBD4" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        <Button x:Name="BtnRefresh" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Content="Refresh status" Margin="10,0,0,0"/>
      </DockPanel>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,2,4">
            <TextBlock Text="Security overview" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Defender results are security detections. The process/service review below is heuristic and may contain false positives." Style="{StaticResource HintText}" Margin="0,0,0,15"/>
            <UniformGrid Columns="4" Margin="0,0,0,4">
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="DEFENDER" Foreground="#97B9D2" FontSize="11"/><TextBlock x:Name="TxtProtection" Text="Checking" FontSize="18" FontWeight="SemiBold" Foreground="#67D8F3" Margin="0,9,0,0"/><TextBlock x:Name="TxtSignatures" Text="Definitions: ..." Style="{StaticResource HintText}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="RUNNING PROCESSES" Foreground="#97B9D2" FontSize="11"/><TextBlock x:Name="TxtProcessCount" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/><TextBlock Text="Audited on request" Style="{StaticResource HintText}" FontSize="11"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="ACTIVE SERVICES" Foreground="#97B9D2" FontSize="11"/><TextBlock x:Name="TxtServiceCount" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/><TextBlock Text="Executables &amp; signatures" Style="{StaticResource HintText}" FontSize="11"/></StackPanel></Border>
              <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="ITEMS TO REVIEW" Foreground="#97B9D2" FontSize="11"/><TextBlock x:Name="TxtReviewCount" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#FBC478" Margin="0,6,0,0"/><TextBlock Text="Heuristics ≠ infection" Style="{StaticResource HintText}" FontSize="11"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource CardBorder}" Padding="19">
              <StackPanel>
                <TextBlock Text="Scan and inspect" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,7"/>
                <TextBlock Text="The audit inventories running processes, services, startup registry entries and scheduled tasks. Quick / Full scans invoke Microsoft Defender Antivirus." Style="{StaticResource HintText}" Margin="0,0,0,15"/>
                <WrapPanel>
                  <Button x:Name="BtnAudit" Style="{StaticResource ActionButton}" Content="Audit processes &amp; services"/>
                  <Button x:Name="BtnQuick" Style="{StaticResource QuietButton}" Content="Defender quick scan"/>
                  <Button x:Name="BtnFull" Style="{StaticResource QuietButton}" Content="Defender full scan"/>
                </WrapPanel>
                <WrapPanel Margin="0,11,0,0">
                  <Button x:Name="BtnUpdate" Style="{StaticResource QuietButton}" Content="Update signatures"/>
                  <Button x:Name="BtnOffline" Style="{StaticResource QuietButton}" Content="Offline / rootkit scan guidance"/>
                  <Button x:Name="BtnWindowsSecurity" Style="{StaticResource QuietButton}" Content="Open Windows Security"/>
                </WrapPanel>
                <TextBlock x:Name="TxtLastScan" Text="No BenCore Shield audit has run in this session." Style="{StaticResource HintText}" Margin="0,16,0,2"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Recent findings and Defender history" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="A flagged item is a lead for investigation, not proof of malware. Defender history may include previously remediated threats." Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                <DataGrid x:Name="GridFindings" Height="200">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Source" Binding="{Binding Category}" Width="125"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="170"/>
                    <DataGridTextColumn Header="Flag" Binding="{Binding Risk}" Width="125"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="PageProcesses" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Running processes" Style="{StaticResource SectionTitle}"/><TextBlock Text="Task Manager-style process inventory. Path and signature checks cannot by themselves prove a process is safe or malicious." Style="{StaticResource HintText}" Margin="0,0,0,16"/></StackPanel>
          <DataGrid x:Name="GridProcesses" Grid.Row="1"><DataGrid.Columns>
            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="PID" Binding="{Binding Identifier}" Width="68"/><DataGridTextColumn Header="Review" Binding="{Binding Risk}" Width="90"/><DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="100"/><DataGridTextColumn Header="Executable" Binding="{Binding Path}" Width="*"/>
          </DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="Select a record, then inspect its folder or copy its SHA-256 hash. BenCore Shield does not terminate processes." Style="{StaticResource HintText}" Margin="0,0,0,8"/><WrapPanel><Button x:Name="BtnProcessFolder" Style="{StaticResource QuietButton}" Content="Open file location"/><Button x:Name="BtnProcessHash" Style="{StaticResource QuietButton}" Content="Copy SHA-256"/></WrapPanel></StackPanel>
        </Grid>
        <Grid x:Name="PageServices" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Running Windows services" Style="{StaticResource SectionTitle}"/><TextBlock Text="Service executables are checked for location and code-signing status. Do not disable an unfamiliar service solely because it appears here." Style="{StaticResource HintText}" Margin="0,0,0,16"/></StackPanel>
          <DataGrid x:Name="GridServices" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="PID" Binding="{Binding Identifier}" Width="65"/><DataGridTextColumn Header="Review" Binding="{Binding Risk}" Width="90"/><DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="105"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BtnServiceFolder" Style="{StaticResource QuietButton}" Content="Open file location"/><Button x:Name="BtnServiceHash" Style="{StaticResource QuietButton}" Content="Copy SHA-256"/></WrapPanel>
        </Grid>
        <Grid x:Name="PageStartup" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Startup &amp; scheduled tasks" Style="{StaticResource SectionTitle}"/><TextBlock Text="Reviews common Run/RunOnce registry locations and selected enabled non-Microsoft scheduled tasks. Not all persistence techniques are covered." Style="{StaticResource HintText}" Margin="0,0,0,16"/></StackPanel>
          <DataGrid x:Name="GridStartup" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="155"/><DataGridTextColumn Header="Review" Binding="{Binding Risk}" Width="90"/><DataGridTextColumn Header="Executable" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="2" Text="Audit only: this app does not change registry startup items or scheduled tasks." Style="{StaticResource HintText}" Margin="0,13,0,0"/>
        </Grid>
        <Grid x:Name="PageDetections" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Microsoft Defender detection history" Style="{StaticResource SectionTitle}"/><TextBlock Text="Detected, removed, blocked or quarantined items are historical records. Review full context and unresolved alerts in Windows Security → Protection history." Style="{StaticResource HintText}" Margin="0,0,0,16"/></StackPanel>
          <DataGrid x:Name="GridDetections" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Threat" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Risk}" Width="135"/><DataGridTextColumn Header="Details" Binding="{Binding Reason}" Width="300"/><DataGridTextColumn Header="Resources" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BtnHistorySecurity" Style="{StaticResource QuietButton}" Content="Open Windows Security"/></WrapPanel>
        </Grid>
        <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,18,0">
          <TextBlock Text="About BenCore Shield" Style="{StaticResource SectionTitle}"/><TextBlock Text="Protect the Core. Secure the System." Foreground="#6CD8F4" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,14"/>
          <Border Style="{StaticResource CardBorder}"><StackPanel>
            <TextBlock Text="BenCore Shield v1.0" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Developed by Benie Mansueto Vison" Foreground="#A8C7DC" Margin="0,8,0,14"/>
            <TextBlock Text="BenCore Shield is a local Windows 11 inspection interface. It does not contain an independent antivirus engine, rootkit detector, threat database, or driver. Microsoft Defender performs the malware scanning. Signature/location checks highlight items for human investigation." TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Rootkits &amp; deep compromise" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Kernel rootkits and fileless malware can hide from user-mode process/service listings. For rootkit concerns, use Microsoft Defender Offline (requires restart), apply Windows updates and consider expert forensic help. Even an offline scan cannot prove a PC is clean." TextWrapping="Wrap" Foreground="#BBD1E5"/></StackPanel></Border>
          <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Safety and privacy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="No cloud upload, public hash lookup, third-party downloads, auto-quarantine, service termination or registry changes. The Windows Defender engine may quarantine threats under its own protection policy. Reports stay under your local user profile unless you export or share them." TextWrapping="Wrap" Foreground="#BBD1E5"/></StackPanel></Border>
          <Button x:Name="BtnOpenReports" Content="Open local report folder" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Background="#13273D" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
        <DockPanel LastChildFill="False"><TextBlock x:Name="TxtStatus" Text="Ready. Nothing scans automatically." TextTrimming="CharacterEllipsis" Foreground="#C4DCEF"/><Button x:Name="BtnExport" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Export last report" Padding="12,5" Margin="12,0,0,0"/></DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
